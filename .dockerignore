# Lab 9 — Docker ignore file
# Prevents sensitive or unnecessary files from being baked into the image

# Virtual environments
venv/
.venv/
env/

# Environment files (contain API keys)
.env
.env.local
.env.production

# Git
.git
.gitignore

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Local databases (will be created at runtime)
*.db
*.sqlite
checkpoint_db.sqlite
hris.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# Documentation (not needed in container)
docs/
*.md
!requirements.txt

# Test artifacts
eval_results.json
tests/

# OS files
.DS_Store
Thumbs.db

# ChromaDB local data (mounted as volume instead)
chroma_db/
